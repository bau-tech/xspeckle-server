+/// The curves (`id`, chords, is-arc) of a sketch without those that have an
+/// end no other curve meets -- a span-direction arrow, a stray line -- dropped
+/// until every remaining end is shared. A curve closed on itself (a full
+/// circle) is kept.
+fn without_open_curves(
+    mut curves: Vec<(u32, Vec<[f64; 4]>, bool)>,
+    eps: f64,
+) -> Vec<(u32, Vec<[f64; 4]>, bool)> {
+    let near =
+        |p: (f64, f64), q: (f64, f64)| (p.0 - q.0).abs() <= eps && (p.1 - q.1).abs() <= eps;
+    loop {
+        let ends: Vec<Option<((f64, f64), (f64, f64))>> = curves
+            .iter()
+            .map(|(_, chords, _)| {
+                let (first, last) = (chords.first()?, chords.last()?);
+                Some(((first[0], first[1]), (last[2], last[3])))
+            })
+            .collect();
+        let shared = |index: usize, point: (f64, f64)| {
+            ends.iter().enumerate().any(|(other, ends)| match ends {
+                Some((start, end)) if other == index => near(*start, *end),
+                Some((start, end)) => near(point, *start) || near(point, *end),
+                None => false,
+            })
+        };
+        let keep: Vec<bool> = ends
+            .iter()
+            .enumerate()
+            .map(|(index, ends)| {
+                ends.is_some_and(|(start, end)| shared(index, start) && shared(index, end))
+            })
+            .collect();
+        if keep.iter().all(|keep| *keep) {
+            return curves;
+        }
+        curves = curves
+            .into_iter()
+            .zip(keep)
+            .filter_map(|(curve, keep)| keep.then_some(curve))
+            .collect();
+    }
+}
