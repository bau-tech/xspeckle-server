#!/usr/bin/env node
import path from 'path'
import { fileURLToPath, pathToFileURL } from 'url'

/**
 * Find gqlgen and run it (we don't want to hardcode a specific node_modules path).
 * We use this so that we can pass in specific flags to node before it even begins to run
 *
 * import.meta.resolve() returns a file:// URL, not a filesystem path -- feeding it
 * straight into the (platform-specific) `path` module mangles it on Windows, where
 * `\` separators don't mix with a URL's `/`s. Round-trip through fileURLToPath/
 * pathToFileURL so this works on both POSIX and Windows.
 */
const relativeBinPath = './bin.js'

const mochaPath = fileURLToPath(import.meta.resolve('@graphql-codegen/cli'))
const mochaPathDir = path.dirname(mochaPath)
const mochaBinPath = path.join(mochaPathDir, relativeBinPath)
await import(pathToFileURL(mochaBinPath).href)
